// Deepcore recipes.
//
// `machine: "hand"` means hand crafting at a Workbench. Everything else names a machine
// from machines.ron. `tech` gates the recipe behind a researched tech node.
// `catalysts` are consumed but not transformed (flux, moulds, coolant).
//
// Processing times are seconds at 1x speed; power comes from the machine unless `power_kw`
// overrides it.

[
    // ================================================================ hand crafting (Era 0)
    (id: "hand_planks", machine: "hand", time: 1.0,
        inputs: [("timber", 1)], outputs: [("planks", 4)]),
    (id: "hand_ladder", machine: "hand", time: 1.5,
        inputs: [("timber", 3)], outputs: [("ladder", 4)]),
    (id: "hand_timber_support", machine: "hand", time: 2.0,
        inputs: [("timber", 4), ("stone_rubble", 2)], outputs: [("timber_support", 2)]),
    (id: "hand_oil_lamp", machine: "hand", time: 2.0,
        inputs: [("clay_lump", 2), ("timber", 1), ("coal", 1)], outputs: [("oil_lamp", 1)]),
    (id: "hand_brick_block", machine: "hand", time: 2.0,
        inputs: [("brick", 4)], outputs: [("brick_block", 1)]),
    (id: "hand_concrete", machine: "hand", time: 2.0,
        inputs: [("gravel_pile", 4), ("sand_pile", 2), ("limestone_chunk", 2)],
        outputs: [("concrete", 4)]),
    (id: "hand_steel_pickaxe", machine: "hand", time: 3.0,
        inputs: [("steel_pickaxe_head", 1), ("timber", 2)], outputs: [("steel_pickaxe", 1)]),

    // ================================================================ Era 1: kiln, furnace, anvil
    (id: "fire_bricks", machine: "brick_kiln", time: 6.0,
        inputs: [("clay_lump", 2)], outputs: [("brick", 2)], tech: "smelting"),
    (id: "fire_bricks_hot", machine: "brick_kiln", time: 10.0,
        inputs: [("brick", 2), ("sand_pile", 1)], outputs: [("fire_brick", 2)], tech: "smelting"),
    (id: "glass_from_sand", machine: "brick_kiln", time: 5.0,
        inputs: [("sand_pile", 2)], outputs: [("glass", 1)], tech: "smelting"),

    (id: "smelt_copper", machine: "stone_furnace", time: 6.0,
        inputs: [("raw_copper", 1)], outputs: [("copper_ingot", 1)], tech: "smelting"),
    (id: "smelt_tin", machine: "stone_furnace", time: 6.0,
        inputs: [("raw_tin", 1)], outputs: [("tin_ingot", 1)], tech: "smelting"),
    (id: "smelt_iron", machine: "stone_furnace", time: 6.0,
        inputs: [("raw_iron", 1)], outputs: [("iron_ingot", 1)], tech: "smelting"),
    (id: "smelt_lead", machine: "stone_furnace", time: 7.0,
        inputs: [("raw_lead", 1)], outputs: [("lead_ingot", 1)], tech: "smelting"),
    (id: "smelt_zinc", machine: "stone_furnace", time: 7.0,
        inputs: [("raw_zinc", 1)], outputs: [("zinc_ingot", 1)], tech: "smelting"),
    (id: "smelt_gold", machine: "stone_furnace", time: 8.0,
        inputs: [("raw_gold", 1)], outputs: [("gold_ingot", 1)], tech: "smelting"),
    (id: "smelt_nickel", machine: "stone_furnace", time: 8.0,
        inputs: [("raw_nickel", 1)], outputs: [("nickel_ingot", 1)], tech: "smelting"),
    (id: "alloy_bronze", machine: "stone_furnace", time: 8.0,
        inputs: [("copper_ingot", 3), ("tin_ingot", 1)], outputs: [("bronze_ingot", 4)],
        tech: "bronze_age"),
    (id: "alloy_brass", machine: "stone_furnace", time: 8.0,
        inputs: [("copper_ingot", 3), ("zinc_ingot", 1)], outputs: [("brass_ingot", 4)],
        tech: "basic_metallurgy"),
    (id: "burn_charcoal", machine: "stone_furnace", time: 5.0,
        inputs: [("timber", 2)], outputs: [("charcoal", 1)], tech: "smelting"),

    (id: "anvil_iron_plate", machine: "anvil", time: 4.0,
        inputs: [("iron_ingot", 2)], outputs: [("iron_plate", 1)], tech: "basic_metallurgy"),
    (id: "anvil_copper_plate", machine: "anvil", time: 4.0,
        inputs: [("copper_ingot", 2)], outputs: [("copper_plate", 1)], tech: "basic_metallurgy"),
    (id: "anvil_lead_plate", machine: "anvil", time: 4.0,
        inputs: [("lead_ingot", 2)], outputs: [("lead_plate", 1)], tech: "basic_metallurgy"),
    (id: "anvil_iron_rod", machine: "anvil", time: 3.0,
        inputs: [("iron_ingot", 1)], outputs: [("iron_rod", 2)], tech: "basic_metallurgy"),
    (id: "anvil_steel_rod", machine: "anvil", time: 3.0,
        inputs: [("steel_ingot", 1)], outputs: [("steel_rod", 2)], tech: "steelmaking"),
    (id: "anvil_iron_gear", machine: "anvil", time: 6.0,
        inputs: [("iron_ingot", 2)], outputs: [("iron_gear", 1)], tech: "basic_metallurgy"),
    (id: "anvil_bronze_gear", machine: "anvil", time: 6.0,
        inputs: [("bronze_ingot", 2)], outputs: [("bronze_gear", 1)], tech: "bronze_age"),
    (id: "anvil_steel_gear", machine: "anvil", time: 7.0,
        inputs: [("steel_ingot", 2)], outputs: [("steel_gear", 1)], tech: "steelmaking"),
    (id: "anvil_steel_plate", machine: "anvil", time: 5.0,
        inputs: [("steel_ingot", 2)], outputs: [("steel_plate", 1)], tech: "steelmaking"),
    (id: "anvil_copper_pipe", machine: "anvil", time: 4.0,
        inputs: [("copper_ingot", 1)], outputs: [("copper_pipe", 2)], tech: "steelmaking"),
    (id: "anvil_steel_pickaxe_head", machine: "anvil", time: 12.0,
        inputs: [("steel_ingot", 3)], outputs: [("steel_pickaxe_head", 1)], tech: "steelmaking"),

    (id: "blast_steel", machine: "blast_furnace", time: 12.0,
        inputs: [("iron_ingot", 2), ("coal", 1)], catalysts: [("limestone_chunk", 1)],
        outputs: [("steel_ingot", 2)], tech: "steelmaking"),
    (id: "blast_hardened_pickaxe", machine: "blast_furnace", time: 20.0,
        inputs: [("steel_pickaxe_head", 1), ("steel_ingot", 2), ("bronze_gear", 1)],
        outputs: [("hardened_steel_pickaxe", 1)], tech: "steelmaking"),
    (id: "blast_steel_support", machine: "blast_furnace", time: 8.0,
        inputs: [("steel_ingot", 2)], outputs: [("steel_support", 4)], tech: "steelmaking"),
    (id: "blast_fire_brick_block", machine: "blast_furnace", time: 8.0,
        inputs: [("fire_brick", 4)], outputs: [("fire_brick_block", 1)], tech: "steelmaking"),
    (id: "blast_graphite_block", machine: "blast_furnace", time: 10.0,
        inputs: [("graphite", 4)], outputs: [("graphite_block", 1)], tech: "advanced_alloys"),
    (id: "blast_lead_shielding", machine: "blast_furnace", time: 8.0,
        inputs: [("lead_ingot", 4)], outputs: [("lead_shielding_block", 2)], tech: "steelmaking"),

    // ================================================================ Era 2: steam and processing
    (id: "crush_copper", machine: "crusher", time: 4.0,
        inputs: [("raw_copper", 1)], outputs: [("crushed_copper", 2)], tech: "ore_processing"),
    (id: "crush_tin", machine: "crusher", time: 4.0,
        inputs: [("raw_tin", 1)], outputs: [("crushed_tin", 2)], tech: "ore_processing"),
    (id: "crush_iron", machine: "crusher", time: 4.0,
        inputs: [("raw_iron", 1)], outputs: [("crushed_iron", 2)], tech: "ore_processing"),
    (id: "crush_lead", machine: "crusher", time: 4.0,
        inputs: [("raw_lead", 1)], outputs: [("crushed_lead", 2)], tech: "ore_processing"),
    (id: "crush_zinc", machine: "crusher", time: 4.0,
        inputs: [("raw_zinc", 1)], outputs: [("crushed_zinc", 2)], tech: "ore_processing"),
    (id: "crush_uranium", machine: "crusher", time: 6.0,
        inputs: [("uranium_ore", 1)], outputs: [("crushed_uranium_ore", 2)],
        tech: "uranium_milling"),
    (id: "crush_stone", machine: "crusher", time: 3.0,
        inputs: [("stone_rubble", 2)], outputs: [("gravel_pile", 2)], tech: "ore_processing"),
    (id: "crush_limestone", machine: "crusher", time: 3.0,
        inputs: [("limestone_chunk", 2)], outputs: [("sand_pile", 1), ("gravel_pile", 1)],
        tech: "ore_processing"),

    (id: "wash_copper", machine: "ore_washer", time: 5.0,
        inputs: [("crushed_copper", 2)], outputs: [("washed_copper", 2)], tech: "ore_processing"),
    (id: "wash_tin", machine: "ore_washer", time: 5.0,
        inputs: [("crushed_tin", 2)], outputs: [("washed_tin", 2)], tech: "ore_processing"),
    (id: "wash_iron", machine: "ore_washer", time: 5.0,
        inputs: [("crushed_iron", 2)], outputs: [("washed_iron", 2)], tech: "ore_processing"),
    (id: "wash_lead", machine: "ore_washer", time: 5.0,
        inputs: [("crushed_lead", 2)], outputs: [("washed_lead", 2)], tech: "ore_processing"),
    (id: "wash_zinc", machine: "ore_washer", time: 5.0,
        inputs: [("crushed_zinc", 2)], outputs: [("washed_zinc", 2)], tech: "ore_processing"),

    (id: "smelt_crushed_copper", machine: "stone_furnace", time: 5.0,
        inputs: [("crushed_copper", 2)], outputs: [("copper_ingot", 3)], tech: "ore_processing"),
    (id: "smelt_crushed_iron", machine: "stone_furnace", time: 5.0,
        inputs: [("crushed_iron", 2)], outputs: [("iron_ingot", 3)], tech: "ore_processing"),
    (id: "smelt_washed_copper", machine: "stone_furnace", time: 5.0,
        inputs: [("washed_copper", 2)], outputs: [("copper_ingot", 4)], tech: "ore_processing"),
    (id: "smelt_washed_iron", machine: "stone_furnace", time: 5.0,
        inputs: [("washed_iron", 2)], outputs: [("iron_ingot", 4)], tech: "ore_processing"),
    (id: "smelt_washed_lead", machine: "stone_furnace", time: 6.0,
        inputs: [("washed_lead", 2)], outputs: [("lead_ingot", 4)], tech: "ore_processing"),
    (id: "smelt_washed_zinc", machine: "stone_furnace", time: 6.0,
        inputs: [("washed_zinc", 2)], outputs: [("zinc_ingot", 4)], tech: "ore_processing"),
    (id: "zinc_cadmium_byproduct", machine: "ore_washer", time: 8.0,
        inputs: [("washed_zinc", 4)], outputs: [("zinc_ingot", 6), ("cadmium", 1)],
        tech: "ore_processing"),
    (id: "wash_salt", machine: "ore_washer", time: 4.0,
        inputs: [("salt", 4)], outputs: [("salt", 3), ("lye", 1)], tech: "electrochemistry"),

    (id: "steam_canister_fill", machine: "steam_boiler", time: 6.0,
        inputs: [("steel_plate", 1)], outputs: [("steam_canister", 2)], tech: "steam_drilling"),
    (id: "steam_drill_assembly", machine: "anvil", time: 18.0,
        inputs: [("steel_plate", 6), ("bronze_gear", 4), ("copper_pipe", 6)],
        outputs: [("steam_drill", 1)], tech: "steam_drilling"),
    (id: "rail_rolling", machine: "anvil", time: 4.0,
        inputs: [("steel_ingot", 1)], outputs: [("rail", 8)], tech: "logistics"),
    (id: "conveyor_assembly", machine: "anvil", time: 5.0,
        inputs: [("iron_plate", 2), ("iron_gear", 1)], outputs: [("conveyor", 4)],
        tech: "logistics"),
    (id: "item_pipe_assembly", machine: "anvil", time: 4.0,
        inputs: [("steel_rod", 2)], outputs: [("item_pipe", 4)], tech: "logistics"),

    // ================================================================ Era 3: electric
    (id: "circuit_mk1_assembly", machine: "circuit_assembler", time: 6.0,
        inputs: [("copper_plate", 2), ("quartz", 2), ("wire", 2)], outputs: [("circuit_mk1", 2)],
        tech: "circuits"),
    (id: "circuit_mk2_assembly", machine: "circuit_assembler", time: 10.0,
        inputs: [("circuit_mk1", 2), ("gold_ingot", 1), ("silicon", 2)],
        outputs: [("circuit_mk2", 1)], tech: "circuits"),
    (id: "circuit_mk3_assembly", machine: "circuit_assembler", time: 16.0,
        inputs: [("circuit_mk2", 2), ("rare_earth_magnet", 1), ("silicon", 4)],
        outputs: [("circuit_mk3", 1)], tech: "precision_engineering"),
    (id: "wire_drawing", machine: "anvil", time: 3.0,
        inputs: [("copper_ingot", 1)], outputs: [("wire", 4)], tech: "circuits"),
    (id: "cable_making", machine: "anvil", time: 4.0,
        inputs: [("wire", 2)], outputs: [("cable", 4)], tech: "electric_power"),

    (id: "arc_silicon", machine: "arc_furnace", time: 8.0,
        inputs: [("quartz", 3), ("coal", 1)], outputs: [("silicon", 1)], tech: "electric_smelting"),
    (id: "arc_steel", machine: "arc_furnace", time: 6.0,
        inputs: [("iron_ingot", 2), ("coal", 1)], outputs: [("steel_ingot", 2)],
        tech: "electric_smelting"),
    (id: "arc_tungsten", machine: "arc_furnace", time: 14.0,
        inputs: [("raw_tungsten", 2), ("coal", 1)], outputs: [("tungsten_ingot", 1)],
        tech: "advanced_alloys"),
    (id: "arc_chromium", machine: "arc_furnace", time: 12.0,
        inputs: [("raw_chromium", 2), ("coal", 1)], outputs: [("chromium_ingot", 1)],
        tech: "advanced_alloys"),
    (id: "arc_zirconium", machine: "arc_furnace", time: 12.0,
        inputs: [("raw_zircon", 2), ("coal", 1)], outputs: [("zirconium_ingot", 1)],
        tech: "advanced_alloys"),

    (id: "electrolysis_aluminium", machine: "electrolysis_cell", time: 12.0,
        inputs: [("raw_bauxite", 3), ("coal", 1)], outputs: [("aluminium_ingot", 2)],
        tech: "electrochemistry"),
    (id: "electrolysis_salt", machine: "electrolysis_cell", time: 8.0,
        inputs: [("salt", 4)], outputs: [("chlorine", 2), ("lye", 2)], tech: "electrochemistry"),
    (id: "electrolysis_copper", machine: "electrolysis_cell", time: 10.0,
        inputs: [("raw_copper", 2), ("sulfuric_acid", 1)], outputs: [("copper_ingot", 3)],
        tech: "electrochemistry"),
    (id: "electrolysis_rare_earth", machine: "electrolysis_cell", time: 16.0,
        inputs: [("rare_earth_concentrate", 2), ("sulfuric_acid", 1)],
        outputs: [("rare_earth_oxide", 2)], tech: "rare_earths"),

    (id: "battery_pack_assembly", machine: "circuit_assembler", time: 12.0,
        inputs: [("lead_plate", 2), ("sulfuric_acid", 2), ("copper_plate", 1)],
        outputs: [("battery_pack", 1)], tech: "electric_storage"),
    (id: "electric_lamp_assembly", machine: "circuit_assembler", time: 5.0,
        inputs: [("glass", 1), ("wire", 1), ("circuit_mk1", 1)], outputs: [("electric_lamp", 2)],
        tech: "mine_safety"),
    (id: "speed_module_assembly", machine: "circuit_assembler", time: 10.0,
        inputs: [("circuit_mk1", 1), ("iron_gear", 2), ("copper_plate", 2)],
        outputs: [("speed_module", 1)], tech: "circuits"),
    (id: "efficiency_module_assembly", machine: "circuit_assembler", time: 10.0,
        inputs: [("circuit_mk1", 1), ("quartz", 2), ("wire", 2)],
        outputs: [("efficiency_module", 1)], tech: "circuits"),
    (id: "headlamp_assembly", machine: "anvil", time: 6.0,
        inputs: [("copper_plate", 1), ("glass", 1), ("battery_pack", 1)],
        outputs: [("headlamp", 1)], tech: "mine_safety"),
    (id: "headlamp_mk2_assembly", machine: "circuit_assembler", time: 8.0,
        inputs: [("headlamp", 1), ("circuit_mk1", 1), ("battery_pack", 1)],
        outputs: [("headlamp_mk2", 1)], tech: "circuits"),

    // ================================================================ Era 4: chemistry and deep metallurgy
    (id: "sulfuric_acid_synthesis", machine: "chemical_plant", time: 10.0,
        inputs: [("sulfur", 2), ("salt", 1)], outputs: [("sulfuric_acid", 2)], tech: "chemistry"),
    (id: "fluorine_compound_synthesis", machine: "chemical_plant", time: 12.0,
        inputs: [("fluorite_crystal", 2), ("sulfuric_acid", 1)],
        outputs: [("fluorine_compound", 2)], tech: "chemistry"),
    (id: "chlorine_bleach", machine: "chemical_plant", time: 8.0,
        inputs: [("chlorine", 1), ("lye", 1)], outputs: [("salt", 2)], tech: "chemistry"),

    (id: "alloy_stainless", machine: "alloy_furnace", time: 16.0,
        inputs: [("steel_ingot", 3), ("nickel_ingot", 1), ("chromium_ingot", 1)],
        outputs: [("stainless_steel_ingot", 3)], tech: "advanced_alloys"),
    (id: "alloy_tungsten_carbide", machine: "alloy_furnace", time: 18.0,
        inputs: [("tungsten_ingot", 2), ("graphite", 2)],
        outputs: [("tungsten_carbide_plate", 1)], tech: "advanced_alloys"),
    (id: "alloy_stainless_casing", machine: "alloy_furnace", time: 10.0,
        inputs: [("stainless_steel_ingot", 2)], outputs: [("stainless_casing", 1)],
        tech: "advanced_alloys"),
    (id: "alloy_steel_casing", machine: "alloy_furnace", time: 8.0,
        inputs: [("steel_ingot", 2)], outputs: [("steel_casing", 1)], tech: "advanced_alloys"),
    (id: "alloy_dense_shielding", machine: "alloy_furnace", time: 12.0,
        inputs: [("shielding_plate", 2), ("lead_ingot", 4)],
        outputs: [("dense_shielding_block", 1)], tech: "waste_handling"),

    (id: "shop_bearing", machine: "machine_shop", time: 8.0,
        inputs: [("steel_ingot", 1), ("bronze_gear", 1)], outputs: [("bearing", 2)],
        tech: "precision_engineering"),
    (id: "shop_turbine_blade", machine: "machine_shop", time: 14.0,
        inputs: [("stainless_steel_ingot", 2), ("bearing", 1)],
        outputs: [("turbine_blade", 1)], tech: "precision_engineering"),
    (id: "shop_centrifuge_rotor", machine: "machine_shop", time: 18.0,
        inputs: [("stainless_steel_ingot", 3), ("bearing", 2), ("tungsten_carbide_plate", 1)],
        outputs: [("centrifuge_rotor", 1)], tech: "precision_engineering"),
    (id: "shop_stainless_rotor", machine: "machine_shop", time: 20.0,
        inputs: [("stainless_steel_ingot", 4), ("centrifuge_rotor", 1), ("bearing", 2)],
        outputs: [("stainless_rotor", 1)], tech: "enrichment"),
    (id: "shop_zirconium_tubing", machine: "machine_shop", time: 12.0,
        inputs: [("zirconium_ingot", 2)], outputs: [("zirconium_tubing", 2)],
        tech: "fuel_fabrication"),

    (id: "separate_rare_earth_oxide", machine: "rare_earth_separator", time: 20.0,
        inputs: [("rare_earth_oxide", 4), ("sulfuric_acid", 2)],
        outputs: [("rare_earth_magnet", 2)], tech: "rare_earths"),
    (id: "separate_monazite", machine: "rare_earth_separator", time: 16.0,
        inputs: [("monazite_sand", 4), ("sulfuric_acid", 1)],
        outputs: [("rare_earth_concentrate", 2)], tech: "rare_earths"),

    (id: "cooling_suit_tailoring", machine: "machine_shop", time: 16.0,
        inputs: [("aluminium_ingot", 6), ("copper_pipe", 4), ("battery_pack", 1)],
        outputs: [("cooling_suit", 1)], tech: "hazard_gear"),
    (id: "respirator_assembly", machine: "machine_shop", time: 10.0,
        inputs: [("aluminium_ingot", 2), ("glass", 1), ("circuit_mk1", 1)],
        outputs: [("respirator", 1)], tech: "hazard_gear"),
    (id: "hazmat_suit_assembly", machine: "machine_shop", time: 24.0,
        inputs: [("lead_plate", 6), ("respirator", 1), ("rare_earth_magnet", 1)],
        outputs: [("hazmat_suit", 1)], tech: "hazard_gear"),
    (id: "ore_scanner_assembly", machine: "circuit_assembler", time: 14.0,
        inputs: [("circuit_mk2", 1), ("quartz", 4), ("copper_plate", 2)],
        outputs: [("ore_scanner", 1)], tech: "ore_scanner"),
    (id: "geiger_assembly", machine: "circuit_assembler", time: 12.0,
        inputs: [("circuit_mk2", 1), ("glass", 1), ("lead_plate", 1)],
        outputs: [("geiger_counter", 1)], tech: "hazard_gear"),
    (id: "battery_drill_assembly", machine: "machine_shop", time: 30.0,
        inputs: [("tungsten_carbide_plate", 2), ("stainless_steel_ingot", 4),
            ("battery_pack", 2), ("rare_earth_magnet", 1)],
        outputs: [("battery_drill", 1)], tech: "deep_drilling"),
    (id: "drill_head_machining", machine: "machine_shop", time: 20.0,
        inputs: [("tungsten_carbide_plate", 1), ("bearing", 1)],
        outputs: [("tungsten_carbide_drill_head", 1)], tech: "deep_drilling"),

    // ================================================================ Era 5: nuclear chain
    (id: "leach_uranium", machine: "leaching_tank", time: 20.0, power_kw: 40.0,
        inputs: [("crushed_uranium_ore", 2), ("sulfuric_acid", 1)],
        outputs: [("uranium_solution", 1), ("radioactive_tailings", 1)],
        tech: "uranium_milling"),
    (id: "precipitate_yellowcake", machine: "precipitator", time: 15.0,
        inputs: [("uranium_solution", 2), ("lye", 1)], outputs: [("yellowcake", 1)],
        tech: "uranium_milling"),
    (id: "convert_to_uf6", machine: "conversion_plant", time: 25.0,
        inputs: [("yellowcake", 1), ("fluorine_compound", 2)],
        outputs: [("uf6_canister", 1)], tech: "uranium_conversion"),
    (id: "enrich_canister", machine: "centrifuge", time: 40.0, power_kw: 150.0,
        inputs: [("uf6_canister", 2)], outputs: [("enriched_canister", 1), ("depleted_canister", 1)],
        tech: "enrichment"),
    (id: "fabricate_fuel_rod", machine: "fuel_fabricator", time: 30.0,
        inputs: [("enriched_canister", 1), ("zirconium_tubing", 2)],
        outputs: [("fuel_rod", 2)], tech: "fuel_fabrication"),
    (id: "fabricate_core_cell", machine: "fuel_fabricator", time: 45.0,
        inputs: [("enriched_canister", 1), ("stainless_casing", 2), ("shielding_plate", 1)],
        outputs: [("compact_core_cell", 1)], tech: "fuel_fabrication"),
    (id: "fabricate_control_rod", machine: "machine_shop", time: 15.0,
        inputs: [("cadmium", 2), ("stainless_steel_ingot", 2)], outputs: [("control_rod", 1)],
        tech: "reactor_safety"),
    (id: "fabricate_shielding_plate", machine: "alloy_furnace", time: 12.0,
        inputs: [("depleted_canister", 1), ("lead_ingot", 2)], outputs: [("shielding_plate", 1)],
        tech: "waste_handling"),
    (id: "cast_waste_cask", machine: "alloy_furnace", time: 10.0,
        inputs: [("radioactive_tailings", 2), ("lead_ingot", 1)],
        outputs: [("waste_cask", 1)], tech: "waste_handling"),
    (id: "mount_core_crystal", machine: "anvil", time: 8.0,
        inputs: [("core_crystal", 1), ("gold_ingot", 2)], outputs: [("dense_shielding_block", 1)],
        tech: "waste_handling"),
    (id: "nuclear_drill_assembly", machine: "machine_shop", time: 60.0,
        inputs: [("compact_core_cell", 1), ("tungsten_carbide_drill_head", 1),
            ("stainless_casing", 4), ("rare_earth_magnet", 2)],
        outputs: [("nuclear_drill", 1)], tech: "nuclear_drill"),

    // ================================================================ machine crafting
    (id: "make_workbench", machine: "hand", time: 4.0,
        inputs: [("timber", 12), ("stone_rubble", 6)], outputs: [("workbench", 1)]),
