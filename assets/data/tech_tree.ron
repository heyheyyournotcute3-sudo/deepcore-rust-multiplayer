// Deepcore tech tree. Team-shared; researched at the Research Desk by delivering items.
// `era` groups nodes in the UI (0..5). `parents` must all be researched first.

[
    // ---------------------------------------------------------------- Era 0
    (
        id: "basic_tools",
        name: "Basic Tools",
        era: 0,
        parents: [],
        cost: [("timber", 8)],
        unlocks: ["workbench", "storage_crate"],
        description: "A bench and a crate: somewhere to craft and somewhere to keep things.",
    ),
    (
        id: "mine_support",
        name: "Mine Support",
        era: 0,
        parents: ["basic_tools"],
        cost: [("timber", 20), ("stone_rubble", 10)],
        unlocks: ["ladder", "timber_support", "oil_lamp"],
        description: "Ladders, props and lamps so the dark does not stop you.",
    ),
    (
        id: "field_research",
        name: "Field Research",
        era: 0,
        parents: ["basic_tools"],
        cost: [("timber", 16), ("copper_ingot", 4)],
        unlocks: ["research_desk"],
        description: "A desk where the team pools what it has learned.",
    ),

    // ---------------------------------------------------------------- Era 1
    (
        id: "smelting",
        name: "Smelting",
        era: 1,
        parents: ["field_research"],
        cost: [("clay_lump", 20), ("stone_rubble", 24), ("coal", 10)],
        unlocks: ["brick_kiln", "stone_furnace"],
        description: "Fired clay and hot rock turn ore into metal.",
    ),
    (
        id: "basic_metallurgy",
        name: "Basic Metallurgy",
        era: 1,
        parents: ["smelting"],
        cost: [("iron_ingot", 12), ("bronze_ingot", 4)],
        unlocks: ["anvil"],
        description: "Beat ingots into plates, rods and gears.",
    ),
    (
        id: "steelmaking",
        name: "Steelmaking",
        era: 1,
        parents: ["basic_metallurgy"],
        cost: [("iron_ingot", 30), ("coal", 20), ("limestone_chunk", 10)],
        unlocks: ["blast_furnace", "steel_ingot", "hardened_steel_pickaxe"],
        description: "Iron, coal and flux make steel. Steel opens the Granite Depths.",
    ),
    (
        id: "bronze_age",
        name: "Bronze Working",
        era: 1,
        parents: ["basic_metallurgy"],
        cost: [("copper_ingot", 16), ("tin_ingot", 8)],
        unlocks: ["bronze_ingot", "bronze_gear"],
        description: "Copper and tin make a tough alloy for gears and fittings.",
    ),

    // ---------------------------------------------------------------- Era 2
    (
        id: "steam_power",
        name: "Steam Power",
        era: 2,
        parents: ["steelmaking"],
        cost: [("steel_plate", 20), ("copper_pipe", 10), ("bronze_gear", 5)],
        unlocks: ["hand_pump", "steam_boiler", "steam_engine"],
        description: "Boil water, pipe the steam, turn a shaft.",
    ),
    (
        id: "ore_processing",
        name: "Ore Processing",
        era: 2,
        parents: ["steam_power"],
        cost: [("steel_plate", 16), ("iron_gear", 6), ("copper_pipe", 8)],
        unlocks: ["crusher", "ore_washer"],
        description: "Crush and wash ore to get more metal from every block.",
    ),
    (
        id: "logistics",
        name: "Logistics",
        era: 2,
        parents: ["steam_power"],
        cost: [("steel_plate", 24), ("iron_gear", 8), ("planks", 16)],
        unlocks: ["rail", "conveyor", "item_pipe", "mine_lift"],
        description: "Move ore out of the mine without carrying it.",
    ),
    (
        id: "steam_drilling",
        name: "Steam Drilling",
        era: 2,
        parents: ["steam_power", "bronze_age"],
        cost: [("steel_plate", 12), ("bronze_gear", 8), ("copper_pipe", 12)],
        unlocks: ["steam_drill", "steam_canister"],
        description: "A steam-driven drill that bites through basalt.",
    ),

    // ---------------------------------------------------------------- Era 3
    (
        id: "electric_power",
        name: "Electric Power",
        era: 3,
        parents: ["steam_power"],
        cost: [("steel_plate", 24), ("copper_ingot", 40), ("circuit_mk1", 2)],
        unlocks: ["steam_turbine", "generator", "cable"],
        description: "Spin a generator and send current down a cable.",
    ),
    (
        id: "electric_storage",
        name: "Electric Storage",
        era: 3,
        parents: ["electric_power", "ore_processing"],
        cost: [("lead_ingot", 20), ("sulfuric_acid", 4), ("circuit_mk1", 4)],
        unlocks: ["battery_bank", "battery_pack", "charging_station"],
        description: "Lead and acid hold charge for the lean hours.",
    ),
    (
        id: "circuits",
        name: "Circuits",
        era: 3,
        parents: ["electric_power"],
        cost: [("quartz", 20), ("copper_ingot", 24), ("gold_ingot", 4)],
        unlocks: ["circuit_assembler", "circuit_mk1"],
        description: "Silicon and copper make logic you can build with.",
    ),
    (
        id: "electric_smelting",
        name: "Electric Smelting",
        era: 3,
        parents: ["electric_power", "circuits"],
        cost: [("steel_plate", 20), ("graphite", 12), ("circuit_mk1", 6)],
        unlocks: ["arc_furnace"],
        description: "An arc furnace smelts faster and makes silicon from quartz.",
    ),
    (
        id: "electrochemistry",
        name: "Electrochemistry",
        era: 3,
        parents: ["electric_power", "smelting"],
        cost: [("lead_plate", 8), ("salt", 20), ("circuit_mk1", 4)],
        unlocks: ["electrolysis_cell", "chlorine", "lye"],
        description: "Current splits salt into chlorine and lye, and bauxite into aluminium.",
    ),
    (
        id: "mine_safety",
        name: "Mine Safety",
        era: 3,
        parents: ["electric_power"],
        cost: [("steel_plate", 16), ("circuit_mk1", 4), ("iron_gear", 6)],
        unlocks: ["vent_fan", "electric_pump", "electric_lamp"],
        description: "Fans and pumps keep gas and water out of the workings.",
    ),
    (
        id: "ore_scanner",
        name: "Ore Scanner",
        era: 3,
        parents: ["circuits"],
        cost: [("circuit_mk2", 2), ("quartz", 12), ("copper_ingot", 16)],
        unlocks: ["ore_scanner"],
        description: "Pulse the rock and read what comes back.",
    ),

    // ---------------------------------------------------------------- Era 4
    (
        id: "chemistry",
        name: "Chemistry",
        era: 4,
        parents: ["electrochemistry", "circuits"],
        cost: [("steel_plate", 30), ("glass", 16), ("sulfuric_acid", 8)],
        unlocks: ["chemical_plant", "sulfuric_acid", "fluorine_compound"],
        description: "Acids and fluorides, made on purpose instead of by accident.",
    ),
    (
        id: "advanced_alloys",
        name: "Advanced Alloys",
        era: 4,
        parents: ["chemistry", "electric_smelting"],
        cost: [("steel_ingot", 30), ("nickel_ingot", 12), ("chromium_ingot", 8)],
        unlocks: ["alloy_furnace", "stainless_steel_ingot", "tungsten_carbide_plate"],
        description: "Stainless steel and tungsten carbide: metals that survive the deep.",
    ),
    (
        id: "precision_engineering",
        name: "Precision Engineering",
        era: 4,
        parents: ["advanced_alloys"],
        cost: [("stainless_steel_ingot", 20), ("steel_gear", 10), ("circuit_mk2", 4)],
        unlocks: ["machine_shop", "bearing", "turbine_blade", "centrifuge_rotor"],
        description: "Bearings, blades and rotors made to tolerances a hand cannot hold.",
    ),
    (
        id: "rare_earths",
        name: "Rare Earths",
        era: 4,
        parents: ["precision_engineering", "chemistry"],
        cost: [("monazite_sand", 24), ("sulfuric_acid", 10), ("circuit_mk2", 4)],
        unlocks: ["rare_earth_separator", "rare_earth_magnet", "rare_earth_oxide"],
        description: "Separate monazite into the magnets high-tier motors need.",
    ),
    (
        id: "hazard_gear",
        name: "Hazard Gear",
        era: 4,
        parents: ["chemistry", "mine_safety"],
        cost: [("lead_plate", 20), ("glass", 10), ("rare_earth_magnet", 2)],
        unlocks: ["cooling_suit", "respirator", "hazmat_suit", "geiger_counter",
            "decon_shower"],
        description: "Suits, filters and a counter that clicks near danger.",
    ),
    (
        id: "deep_drilling",
        name: "Deep Drilling",
        era: 4,
        parents: ["advanced_alloys", "precision_engineering"],
        cost: [("tungsten_carbide_plate", 8), ("stainless_steel_ingot", 16),
            ("circuit_mk2", 6), ("battery_pack", 2)],
        unlocks: ["battery_drill", "tungsten_carbide_drill_head"],
        description: "A battery drill tipped with tungsten carbide opens the Deep Crust.",
    ),

    // ---------------------------------------------------------------- Era 5
    (
        id: "uranium_milling",
        name: "Uranium Milling",
        era: 5,
        parents: ["chemistry", "deep_drilling"],
        cost: [("stainless_steel_ingot", 20), ("sulfuric_acid", 12), ("lye", 8)],
        unlocks: ["leaching_tank", "precipitator", "yellowcake"],
        description: "Leach uranium out of crushed rock and drop it out as yellowcake.",
    ),
    (
        id: "uranium_conversion",
        name: "Uranium Conversion",
        era: 5,
        parents: ["uranium_milling", "rare_earths"],
        cost: [("yellowcake", 8), ("fluorine_compound", 10), ("stainless_steel_ingot", 12)],
        unlocks: ["conversion_plant", "uf6_canister"],
        description: "Convert yellowcake to hexafluoride so it can be spun.",
    ),
    (
        id: "enrichment",
        name: "Enrichment",
        era: 5,
        parents: ["uranium_conversion", "precision_engineering"],
        cost: [("uf6_canister", 6), ("rare_earth_magnet", 8), ("stainless_rotor", 4),
            ("circuit_mk3", 2)],
        unlocks: ["centrifuge", "enriched_canister"],
        description: "A cascade of centrifuges separates the fissile fraction.",
    ),
    (
        id: "fuel_fabrication",
        name: "Fuel Fabrication",
        era: 5,
        parents: ["enrichment", "advanced_alloys"],
        cost: [("enriched_canister", 2), ("zirconium_tubing", 6), ("stainless_casing", 4)],
        unlocks: ["fuel_fabricator", "fuel_rod", "compact_core_cell"],
        description: "Seal enriched fuel in zirconium rods, and a core cell for the drill.",
    ),
    (
        id: "reactor_engineering",
        name: "Reactor Engineering",
        era: 5,
        parents: ["fuel_fabrication"],
        cost: [("reactor_casing", 20), ("graphite_block", 16), ("control_rod", 4),
            ("circuit_mk3", 4)],
        unlocks: ["reactor_core", "reactor_console"],
        description: "Assemble a moderated core that can be controlled, not just lit.",
    ),
    (
        id: "reactor_safety",
        name: "Reactor Safety",
        era: 5,
        parents: ["reactor_engineering"],
        cost: [("control_rod", 4), ("cadmium", 8), ("circuit_mk3", 2)],
        unlocks: ["scram_panel"],
        description: "Cadmium rods and a scram panel: the difference between a reactor and a crater.",
    ),
    (
        id: "nuclear_drill",
        name: "Nuclear Drill",
        era: 5,
        parents: ["fuel_fabrication", "precision_engineering", "rare_earths"],
        cost: [("compact_core_cell", 1), ("tungsten_carbide_drill_head", 1),
            ("stainless_casing", 6), ("rare_earth_magnet", 4)],
        unlocks: ["nuclear_drill"],
        description: "A core cell, a carbide head and a rare-earth motor: a 3x3 tunnel in seconds.",
    ),
    (
        id: "waste_handling",
        name: "Waste Handling",
        era: 5,
        parents: ["reactor_engineering"],
        cost: [("lead_shielding_block", 12), ("concrete", 16), ("stainless_steel_ingot", 8)],
        unlocks: ["cooling_pool", "waste_vault", "waste_cask", "shielding_plate"],
        description: "Cool spent fuel, then bury it where it cannot reach anyone.",
    ),
]
