# Deepcore dedicated server. Builds a release binary and runs it headless.
# No GPU or display is needed on the server.
FROM rust:1.88-bookworm AS builder
WORKDIR /build

# Cache dependencies separately from the source.
COPY Cargo.toml Cargo.lock ./
COPY crates/shared/Cargo.toml crates/shared/
COPY crates/server/Cargo.toml crates/server/
COPY crates/client/Cargo.toml crates/client/
COPY crates/lobby/Cargo.toml crates/lobby/
COPY tools/atlas_gen/Cargo.toml tools/atlas_gen/
RUN mkdir -p crates/shared/src crates/server/src crates/client/src crates/lobby/src tools/atlas_gen/src \
    && echo "" > crates/shared/src/lib.rs \
    && echo "fn main(){}" > crates/server/src/main.rs \
    && echo "fn main(){}" > crates/client/src/main.rs \
    && echo "fn main(){}" > crates/lobby/src/main.rs \
    && echo "fn main(){}" > tools/atlas_gen/src/main.rs \
    && cargo build --release -p deepcore-server || true

COPY . .
RUN cargo build --release -p deepcore-server

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /deepcore
COPY --from=builder /build/target/release/server /usr/local/bin/deepcore-server
COPY assets ./assets
VOLUME ["/deepcore/saves"]
EXPOSE 7777/udp
ENV RUST_LOG=info
ENTRYPOINT ["deepcore-server"]
CMD ["--port", "7777", "--save-dir", "/deepcore/saves"]
